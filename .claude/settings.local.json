{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:alembic.sqlalchemy.org)",
      "Bash(uv pip install alembic 2>&1)",
      "Bash(npm run lint:fix:*)",
      "Bash(npm run format:*)",
      "Bash(npm run validate:*)",
      "Bash(tree:*)",
      "WebSearch",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(find:*)",
      "WebFetch(domain:claude.ai)",
      "mcp__plugin_playwright_playwright__browser_click",
      "mcp__plugin_playwright_playwright__browser_take_screenshot",
      "mcp__plugin_playwright_playwright__browser_hover",
      "mcp__plugin_playwright_playwright__browser_snapshot",
      "mcp__plugin_playwright_playwright__browser_console_messages"
    ]
  },
  "deny": [
      "Bash(**/.env)",
      "Read(**/.env)",
      "Write(**/.env)"
    ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[[ \"$FILE_PATH\" == *.py ]] && ruff check --fix \"$FILE_PATH\" && ruff format \"$FILE_PATH\" || true"
          },
          {
            "type": "command",
            "command": "[[ \"$FILE_PATH\" == *.js ]] && npx eslint --fix \"$FILE_PATH\" && npx prettier --write \"$FILE_PATH\" || true"
          },
          {
            "type": "command",
            "command": "[[ \"$FILE_PATH\" == *.css ]] && npx prettier --write \"$FILE_PATH\" || true"
          },
          {
            "type": "command",
            "command": "[[ \"$FILE_PATH\" == *.html ]] && npx prettier --write \"$FILE_PATH\" || true"
          }
        ]
      }
    ]
  },
  "outputStyle": "default",
  "alwaysThinkingEnabled": true
}

